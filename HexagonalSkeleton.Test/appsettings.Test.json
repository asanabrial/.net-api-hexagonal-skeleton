{
    "ConnectionStrings": {
        "CommandDatabase": "Host=localhost;Port=__POSTGRES_PORT__;Database=hexagonal_test;Username=test_user;Password=test_password",
        "QueryDatabase": "mongodb://test_user:test_password@localhost:__MONGO_PORT__/hexagonal_test?authSource=admin&authMechanism=SCRAM-SHA-1"
    },
    "TestContainers": {
        "Database": "hexagonal_test",
        "Username": "test_user",
        "Password": "test_password",
        "CleanUp": true,
        "StartupTimeoutSeconds": 15,
        "UseSharedContainers": true,
        "EnableContainerLogging": false,
        "Docker": {
            "Images": {
                "PostgreSQL": "debezium/postgres:16",
                "MongoDB": "mongo:8.0",
                "Kafka": "confluentinc/cp-kafka:7.8.0",
                "Zookeeper": "confluentinc/cp-zookeeper:7.8.0",
                "SchemaRegistry": "confluentinc/cp-schema-registry:7.8.0",
                "DebeziumConnect": "debezium/connect:2.5"
            },
            "NetworkAliases": {
                "PostgreSQL": "postgres",
                "MongoDB": "mongodb",
                "Kafka": "kafka",
                "Zookeeper": "zookeeper",
                "SchemaRegistry": "schema-registry",
                "DebeziumConnect": "debezium-connect"
            },
            "Ports": {
                "Kafka": 9092,
                "Zookeeper": 2181,
                "SchemaRegistry": 8081,
                "DebeziumConnect": 8083
            }
        },
        "Kafka": {
            "Port": 9092,
            "InternalPort": 29092,
            "InternalNetworkPort": 29092,
            "Image": "confluentinc/cp-kafka:7.8.0",
            "CleanupAfterTest": true,
            "WaitTimeoutSeconds": 30,
            "LogLevel": "WARN",
            "Environment": {
                "ZookeeperConnect": "zookeeper:2181",
                "Listeners": "INTERNAL://0.0.0.0:29092,EXTERNAL://0.0.0.0:9092",
                "AdvertisedListeners": "INTERNAL://kafka:29092,EXTERNAL://localhost:9092",
                "ListenerSecurityProtocolMap": "INTERNAL:PLAINTEXT,EXTERNAL:PLAINTEXT",
                "InterBrokerListenerName": "INTERNAL",
                "OffsetsTopicReplicationFactor": "1",
                "LogCleanerDeleteRetentionMs": "5000",
                "BrokerId": "1",
                "MinInSyncReplicas": "1",
                "AutoCreateTopicsEnable": "true",
                "GroupInitialRebalanceDelayMs": "0",
                "TransactionStateLogReplicationFactor": "1",
                "TransactionStateLogMinIsr": "1",
                "ZookeeperSessionTimeoutMs": "30000",
                "ZookeeperConnectionTimeoutMs": "20000",
                "SocketSendBufferBytes": "102400",
                "SocketReceiveBufferBytes": "102400",
                "RequestTimeoutMs": "30000",
                "BootstrapServers": "localhost:9092"
            }
        },
        "Zookeeper": {
            "Port": 2181,
            "InternalPort": 2181,
            "Image": "confluentinc/cp-zookeeper:7.8.0",
            "CleanupAfterTest": true,
            "WaitTimeoutSeconds": 30,
            "LogLevel": "WARN",
            "Environment": {
                "ClientPort": "2181",
                "TickTime": "2000",
                "InitLimit": "10",
                "SyncLimit": "5"
            }
        },
        "SchemaRegistry": {
            "Port": 8081,
            "InternalPort": 8081,
            "Image": "confluentinc/cp-schema-registry:7.8.0",
            "CleanupAfterTest": true,
            "WaitTimeoutSeconds": 30,
            "Environment": {
                "KafkastoreBootstrapServers": "kafka:29092",
                "HostName": "schema-registry",
                "Listeners": "http://0.0.0.0:8081",
                "KafkastoreTopicReplicationFactor": "1"
            }
        },
        "Connectors": {
            "PostgreSQLConnectorName": "postgres-users-test-connector",
            "ConnectorType": "postgresql"
        }
    },
    "CDC": {
        "Kafka": {
            "BootstrapServers": "localhost:__KAFKA_PORT__",
            "ProducerClientId": "hexagonal-producer-test",
            "ConsumerClientId": "hexagonal-consumer-test",
            "ConsumerGroupId": "hexagonal-cdc-consumer-group-test",
            "GenerateUniqueGroupId": true,
            "Topics": ["hexagonal-postgres.public.users"]
        },
        "DebeziumConnectUrl": "http://localhost:__DEBEZIUM_PORT__",
        "TableIncludeList": "public.users",
        "TopicPrefix": "hexagonal"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "JwtSettings": {
        "SecretKey": "test-super-secret-key-for-hexagonal-skeleton-application-that-should-be-at-least-256-bits-long-for-security",
        "Issuer": "HexagonalSkeleton.Test",
        "Audience": "HexagonalSkeleton.Test.Users",
        "ExpirationInMinutes": 60
    }
}
